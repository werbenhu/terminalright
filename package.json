{
  "name": "terminalright",
  "displayName": "Terminal Right",
  "description": "Open a terminal in a split view of the editor without moving the bottom panel",
  "version": "1.0.4",
  "publisher": "werbenhu",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/werbenhu/terminalright"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "terminalright.openInRightPanel",
        "title": "%terminalright.openInRightPanel%",
        "category": "Terminal Right",
        "icon": "icon.svg"
      }
    ],
    "keybindings": [
      {
        "command": "terminalright.openInRightPanel",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "terminalright.openInRightPanel",
          "group": "navigation",
          "when": "editorIsOpen"
        }
      ],
      "view/title": [
        {
          "command": "terminalright.openInRightPanel",
          "when": "view == terminal",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Terminal Right",
      "properties": {
        "terminalright.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "%terminalright.config.autoReveal%"
        },
        "terminalright.newTerminalEachTime": {
          "type": "boolean",
          "default": true,
          "description": "%terminalright.config.newTerminalEachTime%"
        },
        "terminalright.splitDirection": {
          "type": "string",
          "enum": [
            "right",
            "left",
            "up",
            "down"
          ],
          "default": "right",
          "description": "%terminalright.config.splitDirection%"
        },
        "terminalright.useFirstCommandAsTitle": {
          "type": "boolean",
          "default": true,
          "description": "%terminalright.config.useFirstCommandAsTitle%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node out/commandTitle.test.js"
  },

  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.56.0",
    "typescript": "^5.9.3"
  }
}
