# Everything not needed at runtime is excluded from the .vsix.
# Keep it explicit so the package stays small and dev-only files never ship.

# Source & build config (compiled out/ IS shipped, see below)
src/
tsconfig.json
package-lock.json

# Dev tooling / metadata
.git/
.gitignore
.gitattributes
.vscode/
.vscode-test/
.claude/
.claude/**

# Build artifacts
*.vsix
out/**/*.js.map
out/**/*.d.ts

# Docs ship? No — keep vsix lean; users read README on the marketplace.
README.zh-cn.md

# Marketplace publisher profile assets (not part of the extension)
publisher-logo.png

# (node_modules excluded by default by vsce)
